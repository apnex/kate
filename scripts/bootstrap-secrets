#!/bin/bash
## bootstrap-secrets — fetch per-env hermes secrets from GCP Secret Manager
##                     + apply to the current kubectl cluster.
##
## Replaces the operator-typed `export FOO=...; ./set-secret` flow with a
## single command that reads every per-deployment value from GCP SM.
##
## Usage: ./bootstrap-secrets <env-name>
##
## Example: ./bootstrap-secrets hermes-vm
##
## Prerequisites:
##   - gcloud auth (operator's identity) with secretmanager.secretAccessor
##     on the kate-<env>-* secrets in the current gcloud project.
##   - kubectl context pointing at the target cluster.
##
## Secret-naming convention (in GCP SM): kate-<env>-<KEY>
##   Required: LITELLM_BASE_URL, LITELLM_MODEL, LITELLM_API_KEY
##   Optional: HERMES_PEER_NAME, DISCORD_BOT_TOKEN, DISCORD_ALLOWED_USERS,
##             GH_TOKEN, HERMES_HOST_SSH_KEY
##
## Note: API_SERVER_KEY is intentionally NOT in this list — it's
## auto-generated in-cluster by hermes/manifests/init-credentials-job.yaml
## on first install.
##
## Bootstrap (one-time per env, e.g. via Terraform in hermes-test/base/):
##   gcloud secrets create kate-<env>-LITELLM_API_KEY --replication-policy=automatic
##   echo -n "sk-real-key" | gcloud secrets versions add kate-<env>-LITELLM_API_KEY --data-file=-
set -eu

ENV="${1:?Usage: $0 <env-name>}"

PROJECT=$(gcloud config get-value project 2>/dev/null)
[[ -n "$PROJECT" ]] || { echo "ERROR: no gcloud project set (run: gcloud config set project <id>)" >&2; exit 1; }

REQUIRED=( LITELLM_BASE_URL LITELLM_MODEL LITELLM_API_KEY )
OPTIONAL=( HERMES_PEER_NAME DISCORD_BOT_TOKEN DISCORD_ALLOWED_USERS GH_TOKEN HERMES_HOST_SSH_KEY )

fetch() {
	gcloud secrets versions access latest --project="$PROJECT" --secret="kate-${ENV}-$1" 2>/dev/null
}

echo "[ BOOTSTRAP-SECRETS ] env=$ENV project=$PROJECT"

for key in "${REQUIRED[@]}"; do
	val=$(fetch "$key") || { echo "ERROR: required secret kate-${ENV}-${key} not found (or no permission)" >&2; exit 1; }
	[[ -n "$val" ]] || { echo "ERROR: required secret kate-${ENV}-${key} is empty" >&2; exit 1; }
	export "$key=$val"
	echo "  + $key (from SM)"
done

for key in "${OPTIONAL[@]}"; do
	val=$(fetch "$key" || true)
	if [[ -n "$val" ]]; then
		export "$key=$val"
		echo "  + $key (from SM, optional)"
	fi
done

echo "[ BOOTSTRAP-SECRETS ] applying via hermes/set-secret ..."
curl -fsSL https://raw.githubusercontent.com/apnex/hermes/main/set-secret | bash
